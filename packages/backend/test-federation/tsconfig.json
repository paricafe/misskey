{
	"compilerOptions": {

		"target": "ESNext",
		"jsx": "react-jsx",
		"jsxImportSource": "@kitajs/html",

		"module": "NodeNext",

		"outDir": "./built",

		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		"strict": true,

		"skipLibCheck": true
	},
	"include": [
		"daemon.ts",
		"./test/**/*.ts"
	]
}
