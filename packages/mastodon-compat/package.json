{
	"name": "@pari/mastodon-compat",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"description": "Standalone Mastodon protocol gateway for the public Misskey HTTP and WebSocket APIs",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": { ".": "./dist/src/index.js" },
	"scripts": {
